# Usuario de login da UI
ADMIN_USER=admin

# Hash bcrypt da senha de login. Gerar com:
# python3 -c "import bcrypt; print(bcrypt.hashpw(input('senha: ').encode(), bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# Token bearer da API. Gerar com:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Chave para assinar sessao e cifrar a senha do certificado. Gerar com:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Diretorio de dados persistentes (volume no Railway). Em dev local use ./data
DATA_DIR=./data
